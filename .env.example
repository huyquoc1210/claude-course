# Copy to .env.local for local development. In production, set these in the server
# environment (e.g. Docker secrets / env vars). The server refuses to start in production
# if any of them is missing.

# Required. Random string of at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. Public base URL of the app, without a trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Required. Path to the SQLite database file. Its directory is created automatically.
# In Docker, point this at the mounted volume (e.g. /data/app.db).
DB_PATH=./data/app.db
